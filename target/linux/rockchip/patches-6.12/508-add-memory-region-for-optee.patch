From fefc1832b9aea2fa7ffaef67ef0fa2195be6e798 Mon Sep 17 00:00:00 2001
From: Jordan Ngako <jordanfalken@gmx.de>
Date: Sat, 24 Jan 2026 17:46:29 +0100
Subject: [PATCH] add memory region for optee

---
 arch/arm64/boot/dts/rockchip/rk3588s.dtsi | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s.dtsi b/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
index 25fdc2a08..8ee7be040 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
@@ -20,6 +20,25 @@ rknpu_reserved: rknpu@a8000000 {
     };
 };
 	
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		optee_core: optee@30000000 {
+			reg = <0x0 0x30000000 0x0 0x02000000>;
+			no-map;
+		};
+	};
+
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+	};
+
     rknpu: npu@fdab0000 {
     	compatible = "rockchip,rk3588-rknpu";
     	reg = <0x0 0xfdab0000 0x0 0x10000>,
-- 
2.52.0

