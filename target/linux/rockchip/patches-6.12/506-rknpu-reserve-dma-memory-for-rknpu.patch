From ddf5f09e5589447ed5101fed1d3394a21dc654c3 Mon Sep 17 00:00:00 2001
From: Jordan Ngako <jordanfalken@gmx.de>
Date: Tue, 6 Jan 2026 21:59:39 +0100
Subject: [PATCH] rknpu: reserve dma memory for rknpu

---
 arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts |  1 +
 arch/arm64/boot/dts/rockchip/rk3588s.dtsi        | 13 +++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts b/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts
index 523407f4e..2171b445b 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts
@@ -201,6 +201,7 @@ vdd_3v3: regulator-vdd-3v3 {
 };
 
 &rknpu{
+	memory-region = <&rknpu_reserved>;
 	status="okay";
 };
 
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s.dtsi b/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
index 82a2e1589..25fdc2a08 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588s.dtsi
@@ -7,6 +7,19 @@
 #include "rk3588-base.dtsi"
 #include "rk3588-opp.dtsi"
 / {
+	reserved-memory {
+    #address-cells = <2>;
+    #size-cells = <2>;
+    ranges;
+
+    rknpu_reserved: rknpu@a8000000 {
+        compatible = "shared-dma-pool";
+        reg = <0x0 0xA8000000 0x0 0x40000000>; /* 1 GiB @ 0xA8000000 */
+        reusable;
+        alignment = <0x0 0x1000>;
+    };
+};
+	
     rknpu: npu@fdab0000 {
     	compatible = "rockchip,rk3588-rknpu";
     	reg = <0x0 0xfdab0000 0x0 0x10000>,
-- 
2.52.0

