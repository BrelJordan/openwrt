From 2cea235d8f12fc056b88901d62008b358a9f6af9 Mon Sep 17 00:00:00 2001
From: Jordan Ngako <jordanfalken@gmx.de>
Date: Sun, 4 Jan 2026 22:27:31 +0100
Subject: [PATCH] rk3588: add rknpu, rkmmu to dts

---
 arch/arm64/boot/dts/rockchip/rk3588-base.dtsi |  99 ++++-
 arch/arm64/boot/dts/rockchip/rk3588-opp.dtsi  | 372 ++++++++++++++++++
 .../boot/dts/rockchip/rk3588s-rock-5c.dts     |   4 +
 arch/arm64/boot/dts/rockchip/rk3588s.dtsi     |  33 ++
 4 files changed, 487 insertions(+), 21 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
index 6769770ea..7bcacd60a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
@@ -1325,6 +1325,25 @@ vp3: port@3 {
 		};
 	};
 
+
+	rknpu_mmu: iommu@fdab9000 {
+		compatible = "rockchip,iommu-v2";
+		reg = <0x0 0xfdab9000 0x0 0x100>,
+		      <0x0 0xfdaba000 0x0 0x100>,
+		      <0x0 0xfdaca000 0x0 0x100>,
+		      <0x0 0xfdada000 0x0 0x100>;
+		interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "npu0_mmu", "npu1_mmu", "npu2_mmu";
+		clocks = <&cru ACLK_NPU0>, <&cru ACLK_NPU1>, <&cru ACLK_NPU2>,
+			 <&cru HCLK_NPU0>, <&cru HCLK_NPU1>, <&cru HCLK_NPU2>;
+		clock-names = "aclk0", "aclk1", "aclk2",
+			      "iface0", "iface1", "iface2";
+		#iommu-cells = <0>;
+		status = "disabled";
+	};
+
 	vop_mmu: iommu@fdd97e00 {
 		compatible = "rockchip,rk3588-iommu", "rockchip,rk3568-iommu";
 		reg = <0x0 0xfdd97e00 0x0 0x100>, <0x0 0xfdd97f00 0x0 0x100>;
@@ -2518,6 +2537,11 @@ pwm15: pwm@febf0030 {
 		status = "disabled";
 	};
 
+	npu_grf: syscon@fd5a2000 {
+		compatible = "rockchip,rk3588-npu-grf", "syscon";
+		reg = <0x0 0xfd5a2000 0x0 0x100>;
+	};
+
 	thermal_zones: thermal-zones {
 		/* sensor near the center of the SoC */
 		package_thermal: package-thermal {
@@ -2771,58 +2795,91 @@ spi4: spi@fecb0000 {
 		status = "disabled";
 	};
 
-	otp: efuse@fecc0000 {
+
+	otp: otp@fecc0000 {
 		compatible = "rockchip,rk3588-otp";
 		reg = <0x0 0xfecc0000 0x0 0x400>;
+		#address-cells = <1>;
+		#size-cells = <1>;
 		clocks = <&cru CLK_OTPC_NS>, <&cru PCLK_OTPC_NS>,
-			 <&cru CLK_OTP_PHY_G>, <&cru CLK_OTPC_ARB>;
-		clock-names = "otp", "apb_pclk", "phy", "arb";
+			 <&cru CLK_OTP_PHY_G>;
+		clock-names = "otpc", "apb", "phy";
 		resets = <&cru SRST_OTPC_NS>, <&cru SRST_P_OTPC_NS>,
 			 <&cru SRST_OTPC_ARB>;
-		reset-names = "otp", "apb", "arb";
-		#address-cells = <1>;
-		#size-cells = <1>;
+		reset-names = "otpc", "apb", "arb";
 
+		/* Data cells */
 		cpu_code: cpu-code@2 {
 			reg = <0x02 0x2>;
 		};
-
+		package_serial_number_high: package-serial-number-high@5 {
+			reg = <0x05 0x1>;
+			bits = <0 1>;
+		};
+		package_serial_number_low: package-serial-number-low@6 {
+			reg = <0x06 0x1>;
+			bits = <5 3>;
+		};
+		specification_serial_number: specification-serial-number@6 {
+			reg = <0x06 0x1>;
+			bits = <0 5>;
+		};
 		otp_id: id@7 {
 			reg = <0x07 0x10>;
 		};
-
-		cpub0_leakage: cpu-leakage@17 {
+		otp_cpu_version: cpu-version@1c {
+			reg = <0x1c 0x1>;
+			bits = <3 3>;
+		};
+		cpub0_leakage: cpub0-leakage@17 {
 			reg = <0x17 0x1>;
 		};
-
-		cpub1_leakage: cpu-leakage@18 {
+		cpub1_leakage: cpub1-leakage@18 {
 			reg = <0x18 0x1>;
 		};
-
-		cpul_leakage: cpu-leakage@19 {
+		cpul_leakage: cpul-leakage@19 {
 			reg = <0x19 0x1>;
 		};
-
 		log_leakage: log-leakage@1a {
 			reg = <0x1a 0x1>;
 		};
-
 		gpu_leakage: gpu-leakage@1b {
 			reg = <0x1b 0x1>;
 		};
-
-		otp_cpu_version: cpu-version@1c {
-			reg = <0x1c 0x1>;
-			bits = <3 3>;
+		customer_demand: customer-demand@22 {
+			reg = <0x22 0x1>;
+			bits = <4 4>;
 		};
-
 		npu_leakage: npu-leakage@28 {
 			reg = <0x28 0x1>;
 		};
-
 		codec_leakage: codec-leakage@29 {
 			reg = <0x29 0x1>;
 		};
+		cpul_opp_info: cpul-opp-info@3d {
+			reg = <0x3d 0x6>;
+		};
+		cpub01_opp_info: cpub01-opp-info@43 {
+			reg = <0x43 0x6>;
+		};
+		cpub23_opp_info: cpub23-opp-info@49 {
+			reg = <0x49 0x6>;
+		};
+		gpu_opp_info: gpu-opp-info@4f {
+			reg = <0x4f 0x6>;
+		};
+		npu_opp_info: npu-opp-info@55 {
+			reg = <0x55 0x6>;
+		};
+		dmc_opp_info: dmc-opp-info@5b {
+			reg = <0x5b 0x6>;
+		};
+		vop_opp_info: vop-opp-info@61 {
+			reg = <0x61 0x6>;
+		};
+		venc_opp_info: venc-opp-info@67 {
+			reg = <0x67 0x6>;
+		};
 	};
 
 	dmac2: dma-controller@fed10000 {
