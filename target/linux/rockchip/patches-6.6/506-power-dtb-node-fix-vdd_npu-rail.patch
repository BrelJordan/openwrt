From 09421fb535ff758845cc8908ebd16e5442dd832c Mon Sep 17 00:00:00 2001
From: Jordan Ngako <jordanfalken@gmx.de>
Date: Mon, 29 Dec 2025 23:00:49 +0100
Subject: [PATCH] power dtb node: fix vdd_npu rail

---
 arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts b/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts
index e398fd520..474aca996 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts
@@ -196,6 +196,7 @@ pd_npu: power-domain@RK3568_PD_NPU {
         // pm_qos = <&qos_npu>;
 
         #power-domain-cells = <0>;
+		domain-supply = <&vdd_npu>;
     };
 };
 
@@ -383,6 +384,7 @@ regulator-state-mem {
 
 			vdd_npu: DCDC_REG4 {
 				regulator-name = "vdd_npu";
+				regulator-boot-on;
 				regulator-initial-mode = <0x2>;
 				regulator-min-microvolt = <500000>;
 				regulator-max-microvolt = <1350000>;
-- 
2.52.0

